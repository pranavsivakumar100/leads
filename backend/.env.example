# App
APP_NAME=Leadflow API
ENVIRONMENT=development

# Comma-separated allowed CORS origins (the frontend dev + prod URLs).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Maps Platform — Places API (New). Enables the lead scraper.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase (leave blank to run stateless / without auth-gated persistence).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# AI sales coach (leave blank to disable live suggestions).
# Works with any OpenAI-compatible chat completions API.
OPENAI_API_KEY=
COACH_MODEL=gpt-4o-mini
COACH_BASE_URL=https://api.openai.com/v1

# Twilio Voice — browser dialer (server-side only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Public origin Twilio fetches TwiML from (Railway URL in prod).
PUBLIC_API_BASE_URL=

# Local only: let this machine's .env keys stand in until you save your own
# in Settings. Leave unset / false in production so each account uses its keys.
ALLOW_ENV_KEY_FALLBACK=false
