# App
APP_NAME=Leadflow API
ENVIRONMENT=development

# Comma-separated allowed CORS origins (the frontend dev + prod URLs).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Maps Platform — Places API (New). Enables the lead scraper.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase (leave blank to run stateless / without auth-gated persistence).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key
