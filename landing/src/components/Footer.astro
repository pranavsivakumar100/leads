---
import { APP_URL, SITE_NAME } from "../consts";
import BrandMark from "./BrandMark.astro";

const year = new Date().getFullYear();

const cols = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "How it works", href: "#how" },
      { label: "Pricing", href: "#pricing" },
      { label: "Sign in", href: APP_URL },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "FAQ", href: "#faq" },
      { label: "Contact", href: "mailto:hello@leadflow.example.com" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="/">
        <BrandMark size={22} color="#8fcb9b" />
        <span>{SITE_NAME}</span>
      </a>
      <p class="footer__tag">
        Local business leads, ranked and ready to call.
      </p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {
        cols.map((col) => (
          <div class="footer__col">
            <h3 class="footer__col-title">{col.title}</h3>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer__bottom">
    <span>© {year} {SITE_NAME}. All rights reserved.</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--dark-text);
    padding: 64px 0 32px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 48px;
    padding-bottom: 40px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
  }

  .footer__tag {
    margin: 14px 0 0;
    max-width: 30ch;
    color: var(--dark-text-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .footer__col-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dark-text-muted);
    margin-bottom: 14px;
  }

  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .footer__col a {
    color: var(--dark-text);
    font-size: 0.94rem;
    transition: color 0.15s ease;
  }

  .footer__col a:hover {
    color: #8fcb9b;
  }

  .footer__bottom {
    padding-top: 26px;
    border-top: 1px solid var(--dark-border);
    font-size: 0.85rem;
    color: var(--dark-text-muted);
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 520px) {
    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
