---
import { APP_URL } from "../consts";

const plans = [
  {
    name: "Starter",
    price: "$0",
    cadence: "/ forever",
    blurb: "For trying Leadflow on your first market.",
    features: [
      "Up to 100 leads / month",
      "Review-quality scoring",
      "CSV export",
      "1 saved campaign",
    ],
    cta: "Get started free",
    featured: false,
  },
  {
    name: "Pro",
    price: "$49",
    cadence: "/ month",
    blurb: "For closers running outbound every day.",
    features: [
      "Unlimited leads & deep search",
      "Offer-fit scoring",
      "Live AI call coaching",
      "Unlimited campaigns & scripts",
      "CSV + Excel export",
    ],
    cta: "Start Pro",
    featured: true,
  },
  {
    name: "Team",
    price: "$149",
    cadence: "/ month",
    blurb: "For agencies with a room full of dials.",
    features: [
      "Everything in Pro",
      "Up to 5 seats",
      "Shared lead library",
      "Team campaign reporting",
      "Priority support",
    ],
    cta: "Talk to us",
    featured: false,
  },
];
---

<section class="section pricing" id="pricing">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">Pricing</span>
      <h2 class="section__title">Simple plans that pay for themselves</h2>
      <p class="section__lede">
        One booked meeting usually covers the month. Start free, upgrade when the
        pipeline's flowing.
      </p>
    </div>

    <div class="plans">
      {
        plans.map((p) => (
          <article class={`plan${p.featured ? " plan--featured" : ""}`}>
            {p.featured && <span class="plan__tag">Most popular</span>}
            <h3 class="plan__name">{p.name}</h3>
            <div class="plan__price">
              <span class="plan__amount">{p.price}</span>
              <span class="plan__cadence">{p.cadence}</span>
            </div>
            <p class="plan__blurb">{p.blurb}</p>
            <a
              class={`btn ${p.featured ? "btn--primary" : "btn--secondary"}`}
              href={APP_URL}
              style="width:100%"
            >
              {p.cta}
            </a>
            <ul class="plan__features">
              {p.features.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }

  .plan {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
  }

  .plan--featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), var(--shadow-md);
  }

  .plan__tag {
    position: absolute;
    top: -12px;
    left: 26px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-contrast);
    background: var(--accent);
    padding: 4px 11px;
    border-radius: 999px;
  }

  .plan__name {
    font-size: 1.3rem;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 12px 0 4px;
  }

  .plan__amount {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
  }

  .plan__cadence {
    color: var(--text-subtle);
    font-size: 0.9rem;
  }

  .plan__blurb {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 0.94rem;
    min-height: 42px;
  }

  .plan__features {
    list-style: none;
    margin: 22px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 11px;
  }

  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.94rem;
    color: var(--text);
  }

  .plan__features svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--accent-text);
  }

  @media (max-width: 900px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
